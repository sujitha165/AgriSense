# AgriSense Environment Configuration Template
# Duplicate this file as .env in root or backend/ and frontend/

# Backend Server Port
PORT=5000

# Authentication JWT Secret
JWT_SECRET=agrisense-super-secret-key-harvest-2026
JWT_EXPIRES_IN=7d

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=agrisense_db
DATABASE_URL=mysql://root:@localhost:3306/agrisense_db

# External AI Vision Detection Model Endpoint (Optional)
# Leave blank to use AgriSense's built-in diagnostic pathology engine
AI_API_URL=
AI_API_KEY=

# Frontend Environment Variables (in frontend/.env)
VITE_API_URL=http://localhost:5000/api

# Real AI image-classification microservice
AI_API_URL=http://127.0.0.1:8000

# Optional live farmer assistant. Keep this key server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional OpenAI-compatible endpoint, otherwise the official OpenAI endpoint is used.
AI_CHAT_BASE_URL=https://api.openai.com/v1
